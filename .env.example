# Public client configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for release clients; development uses the current Metro host.
EXPO_PUBLIC_API_BASE_URL=https://mora.expo.app

# Server only. Never use an EXPO_PUBLIC_ prefix for these.
AI_GATEWAY_API_KEY=
USDA_API_KEY=
GEMINI_API_KEY=
# Optional nutrition search/cache and alternative speech provider
PERPLEXITY_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ELEVENLABS_API_KEY=

# Optional model/voice overrides
CHAT_MODEL=google/gemini-3-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_LIVE_VOICE=Aoede
GEMINI_TTS_VOICE=Aoede
